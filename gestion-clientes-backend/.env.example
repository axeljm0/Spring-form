# ==========================================================
# PLANTILLA DE VARIABLES DE ENTORNO (BACKEND)
# Copia este archivo como .env y edita tus credenciales
# ==========================================================
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# H2 Database (Por defecto)
DB_URL=jdbc:h2:file:./data/clientesdb;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# MySQL Database (Ejemplo)
# DB_URL=jdbc:mysql://localhost:3306/gestion_clientes?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=root
# DB_PASSWORD=tu_contraseña_aqui

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
H2_CONSOLE_ENABLED=true
